# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paperprints
DB_USER=admin
DB_PASSWORD=secret
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/paperprints?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=paperprints-files

# Cloudinary (alternative to S3 for dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PDF Service
PDF_SERVICE_URL=http://localhost:8001

# File Upload
MAX_FILE_SIZE_MB=50

# Email
GMAIL_USER=paperprintsofficial@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Admin
ADMIN_SECRET=paperprints_admin_2024
